{
  "name": "incos-buzon-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Buzón de quejas anónimo del ecosistema SIA-INCOS",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tipos": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply buzon-incos --local",
    "db:migrar": "wrangler d1 migrations apply buzon-incos --remote",
    "seed": "node scripts/seed.mjs",
    "seed:local": "node scripts/seed.mjs --local",
    "pruebas": "node scripts/pruebas.mjs",
    "ver-db": "node scripts/ver-db.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.0.0"
  }
}
